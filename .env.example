# Copy this file to .env.local and fill in the values for the wandb account
# you want this project's runs to go to. .env.local is git-ignored, and its
# values OVERRIDE anything inherited from the shell environment -- so a
# team-wide WANDB_API_KEY exported globally won't pollute these runs.
#
# Get your personal API key from: https://wandb.ai/authorize
# (make sure you're logged in as the account you want runs to land in).

# --- Authentication --------------------------------------------------------
WANDB_API_KEY=

# --- Run targeting ---------------------------------------------------------
# WANDB_ENTITY is your wandb username OR a team you own (e.g. "alice" or
# "alice-research-team"). Leave blank to let wandb pick the default entity
# attached to WANDB_API_KEY -- usually your personal username.
WANDB_ENTITY=

# Project name (created automatically on first run).
WANDB_PROJECT=smiles-2026-hallucination

# Default run name and tags (optional; usually set per-run on the command
# line instead so you don't forget to bump them between experiments).
# WANDB_RUN_NAME=baseline-last-token
# WANDB_TAGS=baseline,last-token

# --- Mode ------------------------------------------------------------------
# online | offline | disabled
WANDB_MODE=online
